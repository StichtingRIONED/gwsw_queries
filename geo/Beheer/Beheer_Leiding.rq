# Beheer_Leiding.rq (20170930)

# 20261016/mv: Selecteer op datum inwinning bobB bobE, alleen meest recente waarde gebruiken
# 20260416/mv: Alleen meest recente datum Inspecteren en Reinigen (voorkom dubbele geo-objecten)

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

#PREFIX gwsw: <http://data.gwsw.nl/1.7/totaal/>
PREFIX gwsw: <{{&version}}>

SELECT ?Stelsel ?stelseltype ?naam ?uri ?type ?Lijn ?beginpunt ?uriB ?eindpunt ?uriE ?Begindatum ?Einddatum ?BobBeginpuntLeiding ?datumInwinningBobBegin ?wijzeInwinningBobBegin ?BobEindpuntLeiding ?datumInwinningBobEind ?wijzeInwinningBobEind ?MateriaalLeiding ?VormLeiding ?BreedteLeiding ?HoogteLeiding ?LengteLeiding ?Wanddikte ?Verbindingstype ?Fundering ?datumLining ?DatumInspectie ?DatumReiniging ?WIONThema ?AantalWoningen ?Aantal_ieBedrijven ?Aantal_ieRecreatie ?AfvoerendOppervlak

WHERE
{ 
  ?lei rdf:type gwsw:Leiding .
  
  # Alles, behalve: (20190403)
  FILTER NOT EXISTS { ?lei rdf:type gwsw:Aansluitleiding . }
  FILTER NOT EXISTS { ?lei rdf:type gwsw:Goot . }

  ?lei sesame:directType ?type .
  FILTER (!(isBlank(?lei)))
  FILTER (!(isBlank(?type)))
  
  ?lei rdfs:label ?naam .

	optional {?lei gwsw:isPartOf 
	[ rdf:type gwsw:Stelsel ;
	rdfs:label ?Stelsel ;
	sesame:directType ?stelseltype ;
	] . }
	  
  ?lei gwsw:hasAspect ?ori .
  ?ori rdf:type gwsw:Leidingorientatie .

  ?ori gwsw:hasAspect # geometrie moet er zijn vanaf GWSW 1.4
  [ 
    rdf:type gwsw:Lijn ;
    gwsw:hasValue ?Lijn ;
  ] .
  optional { # aansluiting begin. Hou synchroon: hyd_verbinding, mds_leiding
    ?ori gwsw:hasPart ?bpnt .
    ?bpnt rdf:type gwsw:BeginpuntLeiding .
    ?bpnt gwsw:hasConnection [ gwsw:isAspectOf ?_uriB ;] . # lei in de query-resultaten voor zoekwerk (20200708)
    ?_uriB rdfs:label ?beginpunt .

    optional { # Bob
      { # Inwinning erbij?
        { 
          SELECT ?bpnt (MAX(?datInw1) as ?datumInwinningBobBegin) # Zoek de meest recente waarde (hou var-naam uniek: 2x aspInw?, 2x datInw?, 1x maxDat?) (20261015)
            WHERE {
              ?bpnt gwsw:hasAspect ?aspInw1 .
              ?aspInw1 rdf:type gwsw:BobBeginpuntLeiding ;
                      gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datInw1 ; ] ; ] .
            } GROUP BY ?bpnt
        }
        # Lees de gegevens bij maxDat? (hou var-naam uniek: 3x asp?)
        ?bpnt gwsw:hasAspect ?asp1 .
        ?asp1 rdf:type gwsw:BobBeginpuntLeiding ; 
              gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datumInwinningBobBegin ; ] ; ] ;
              gwsw:hasValue ?BobBeginpuntLeiding .

        optional { # wijze van inwinning?
          ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningBobBegin ; ] ; ] ;
        }
      }
      UNION { # waarden zonder inwinning-meta (hou var-naam uniek: 3x asp?) (20261013)
        ?bpnt gwsw:hasAspect ?asp1 .
        # de boel is al verwerkt in de subquery?
        FILTER NOT EXISTS {?asp1 rdf:type gwsw:BobBeginpuntLeiding; gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; ] ; ] .}
        ?asp1 gwsw:hasValue  ?BobBeginpuntLeiding . 

        optional { # geen datum maar wel wijze van inwinning?
          ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningBobBegin ; ] ; ] ;
        }

      }
    }
  }
  optional { # aansluiting eind. Hou synchroon: hyd_verbinding, mds_leiding
    ?ori gwsw:hasPart ?epnt .
    ?epnt rdf:type gwsw:EindpuntLeiding .
    ?epnt gwsw:hasConnection [ gwsw:isAspectOf ?_uriE ;] . # lei in de query-resultaten voor zoekwerk (20200708)
    ?_uriE rdfs:label ?eindpunt .

    optional { # Bob
      { # Inwinning erbij?
        { 
          SELECT ?epnt (MAX(?datInw2) as ?datumInwinningBobEind) # Zoek de meest recente waarde (hou var-naam uniek: 2x aspInw?, 2x datInw?, 1x maxDat?) (20261015)
            WHERE {
              ?epnt gwsw:hasAspect ?aspInw2 .
              ?aspInw2 rdf:type gwsw:BobEindpuntLeiding ;
                      gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datInw2 ; ] ; ] .
            } GROUP BY ?epnt
        }
        # Lees de gegevens bij maxDat? (hou var-naam uniek: 3x asp?)
        ?epnt gwsw:hasAspect ?asp2 .
        ?asp2 rdf:type gwsw:BobEindpuntLeiding ; 
              gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datumInwinningBobEind ; ] ; ] ;
              gwsw:hasValue ?BobEindpuntLeiding .

        optional { # wijze van inwinning?
          ?asp2 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningBobEind ; ] ; ] ;
        }
      }
      UNION { # waarden zonder inwinning-meta (hou var-naam uniek: 3x asp?) (20261013)
        ?epnt gwsw:hasAspect ?asp2 .
        # de boel is al verwerkt in de subquery?
        FILTER NOT EXISTS {?asp2 rdf:type gwsw:BobEindpuntLeiding; gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; ] ; ] .}
        ?asp2 gwsw:hasValue ?BobEindpuntLeiding . 

        optional { # geen datum maar wel wijze van inwinning?
          ?asp2 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningBobEind ; ] ; ] ;
        }
      }
    }
  }

  #optional # aansluiting begin. Hou synchroon: hyd_verbinding, mds_leiding
  #{
  #  ?ori gwsw:hasPart ?bpnt .
  #  ?bpnt rdf:type gwsw:BeginpuntLeiding .
  #  ?bpnt gwsw:hasConnection ?bconn . # Let op: niet optioneel, anders loopt query slecht
  #  optional {
  #      ?bpnt gwsw:hasAspect ?bobB .
  #      ?bobB rdf:type gwsw:BobBeginpuntLeiding ;
  #            gwsw:hasValue ?BobBeginpuntLeiding .
  #      optional {?bobB gwsw:hasAspect
  #      [
  #          rdf:type gwsw:Inwinning ;
  #          gwsw:hasAspect [
  #          rdf:type gwsw:DatumInwinning ;
  #          gwsw:hasValue ?datumInwinningBobBegin ;
  #          ] ;
  #      ] . }
  #      optional {?bobB gwsw:hasAspect
  #      [
  #          rdf:type gwsw:Inwinning ;
  #          gwsw:hasAspect [
  #          rdf:type gwsw:WijzeVanInwinning ;
  #          gwsw:hasReference ?wijzeInwinningBobBegin ;
  #          ] ;
  #      ] . }
  #  }
  #  ?bconn gwsw:isAspectOf ?_uriB . # lei in de query-resultaten voor zoekwerk (20200708)
  #  ?_uriB rdfs:label ?beginpunt .
  #}

   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:Begindatum ;
       gwsw:hasValue ?Begindatum ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:MateriaalLeiding ;
       gwsw:hasReference ?MateriaalLeiding ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:VormLeiding ;
       gwsw:hasReference ?VormLeiding ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
      rdf:type gwsw:DiameterLeiding ;
       gwsw:hasValue ?dia ;  
   ] .}
   optional {?lei gwsw:hasAspect 
   [
      rdf:type gwsw:BreedteLeiding ;
      gwsw:hasValue ?br ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:HoogteLeiding ;
       gwsw:hasValue ?HoogteLeiding ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:LengteLeiding ;
       gwsw:hasValue ?LengteLeiding ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:Wanddikte ;
       gwsw:hasValue ?Wanddikte ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:Verbindingstype ;
       gwsw:hasReference ?Verbindingstype ;
   ] .}
   optional {?lei gwsw:hasPart 
   [
       rdf:type gwsw:Fundering ;
       sesame:directType ?Fundering ;
   ] .}
   optional {?lei gwsw:hasPart 
   [
     rdf:type gwsw:Lining ;
     gwsw:hasAspect
     [
	  rdf:type gwsw:Begindatum ;
	  gwsw:hasValue ?datumLining ;
     ];
   ] .}
  optional { # Bepaal de meest recente datum (20260416)
    SELECT ?lei (MAX(?dat) as ?DatumInspectie)
    WHERE
    {
        ?lei gwsw:isInputOf [
          rdf:type gwsw:Inspecteren ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?lei
  }
  optional { # Bepaal de meest recente datum (20260416)
    SELECT ?lei (MAX(?dat) as ?DatumReiniging)
    WHERE
    {
        ?lei gwsw:isInputOf [
          rdf:type gwsw:Reinigen ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?lei
  }
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:WIONThema ;
       gwsw:hasReference ?WIONThema ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:AantalWoningen ;
       gwsw:hasValue ?AantalWoningen ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieBedrijven ;
       gwsw:hasValue ?Aantal_ieBedrijven ;
   ] .}
   optional {?lei gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieRecreatie ;
       gwsw:hasValue ?Aantal_ieRecreatie ;
   ] .}
   optional
   {
        SELECT ?lei (sum(?ao) as ?AfvoerendOppervlak) # sommeer de types ao
        WHERE
        {
           optional {?lei gwsw:hasAspect 
           [
               rdf:type gwsw:AfvoerendOppervlak ;
               gwsw:hasValue ?ao ;
           ] .}
        }
        GROUP BY ?lei
   }
  BIND (strafter(str(?lei), "#") AS ?uri)
  BIND (IF (BOUND(?_uriB), strafter(str(?_uriB), "#"), "") AS ?uriB)
  BIND (IF (BOUND(?_uriE), strafter(str(?_uriE), "#"), "") AS ?uriE)
  BIND (COALESCE (?br, ?dia) as ?BreedteLeiding) # de eerst geldende doet mee (20210521)
}
