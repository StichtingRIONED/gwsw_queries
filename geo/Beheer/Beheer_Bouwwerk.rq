# Beheer_Bouwwerk.rq - Alle bouwwwerken

# 20261016/mv: Voor 3D weergave: contouren bouwwerk en hoogte-bouwwerk erbij (?Buitengrens, ?HoogteBouwwerk)
#              Buitengrens en HoogteBouwwerk alleen voor 3D nabewerking (export CityGML), niet in GML/XSD ivm PDOK-afstemming
# 20200128/mv: Geometrie gespecialiseerd naar Punt
#              Alle bouwwerken meenemen, ook Gemaal (geen pompput) en Uitlaatconstructie: op kleine schaal zichtbaar in PDOK

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

#PREFIX gwsw: <http://data.gwsw.nl/1.7/totaal/>
PREFIX gwsw: <{{&version}}> 

SELECT DISTINCT ?Stelsel ?stelseltype ?naam ?uri ?type ?Punt ?Buitengrens ?Begindatum ?Einddatum ?BreedteBouwwerk ?LengteBouwwerk ?HoogteBouwwerk

WHERE
{ 

# (20200128)
#   { ?bwk rdf:type gwsw:Reservoir . }
#   UNION
#   { ?bwk rdf:type gwsw:RWZI .}
   ?bwk rdf:type gwsw:Bouwwerk .   

   ?bwk sesame:directType ?type .
    
   FILTER (!(isBlank(?bwk)))
   FILTER (!(isBlank(?type)))
    
   ?bwk rdfs:label ?naam .
   
   optional
   {   
      ?bwk gwsw:isPartOf 
      [ rdf:type gwsw:Stelsel ;
        rdfs:label ?Stelsel ;
        sesame:directType ?stelseltype ;
      ] .
   }
   ?bwk gwsw:hasAspect ?ori .
   ?ori rdf:type gwsw:Bouwwerkorientatie .
   
   ?ori gwsw:hasAspect [ rdf:type gwsw:Punt ; gwsw:hasValue ?Punt ; ] .
   optional {?ori gwsw:hasAspect [ rdf:type gwsw:Buitengrens ; gwsw:hasValue ?Buitengrens ; ] .} # Toegevoegd (niet in XSD, alleen voor 3D bewerking) (20261016)

   optional {?bwk gwsw:hasAspect 
   [
       rdf:type gwsw:Begindatum ;
       gwsw:hasValue ?Begindatum ;
   ] .}
   optional {?bwk gwsw:hasAspect 
   [
       rdf:type gwsw:Einddatum ;
       gwsw:hasValue ?Einddatum ;
   ] .}
   optional {?bwk gwsw:hasAspect 
   [
       rdf:type gwsw:BreedteBouwwerk ;
       gwsw:hasValue ?BreedteBouwwerk ;
   ] .}
   optional {?bwk gwsw:hasAspect 
   [
       rdf:type gwsw:LengteBouwwerk ;
       gwsw:hasValue ?LengteBouwwerk ;
   ] .}
   optional {?bwk gwsw:hasAspect 
   [
       rdf:type gwsw:HoogteBouwwerk ;
       gwsw:hasValue ?HoogteBouwwerk ;
   ] .}
    BIND (strafter(str(?bwk), "#") AS ?uri)
}
