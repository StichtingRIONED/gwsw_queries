# Beheer_Put.rq (20170930)
# 20261013/mv: Selecteer op datum inwinning, alleen meest recente waarde gebruiken
# 20260416/mv: Alleen meest recente datum Inspecteren en Reinigen (voorkom dubbele geo-objecten)

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

#PREFIX gwsw: <http://data.gwsw.nl/1.7/totaal/>
PREFIX gwsw: <{{&version}}>

SELECT ?Stelsel ?stelseltype ?naam ?uri ?type ?Punt ?Begindatum ?Einddatum ?Maaiveldhoogte ?datumInwinningMaaiveld ?wijzeInwinningMaaiveld ?MateriaalPut ?VormPut ?BreedtePut ?LengtePut ?HoogtePut ?Wanddikte ?Fundering ?DatumReiniging ?DatumInspectie ?AantalWoningen ?Aantal_ieBedrijven ?Aantal_ieRecreatie ?AfvoerendOppervlak ?BergendOppervlak

WHERE
{ 
   ?put rdf:type gwsw:Rioolput .
   
   # Via thema Aansluiting (20190403)
   #UNION
   #{ ?put rdf:type gwsw:Kolk . }
   
   ?put sesame:directType ?type .
    
   FILTER (!(isBlank(?put)))
   FILTER (!(isBlank(?type)))
 
   # Nog niet actief gemaakt, kloppen de datasets voldoende?
   #FILTER NOT EXISTS { ?type rdfs:subClassOf gwsw:ExtraObjecttype } # Alleen functionele types (20261011)
   
   ?put rdfs:label ?naam .

   optional
   {   
      ?put gwsw:isPartOf 
      [ rdf:type gwsw:Stelsel ;
        rdfs:label ?Stelsel ;
        sesame:directType ?stelseltype ;
      ] .
   }
   ?put gwsw:hasAspect ?ori .
   ?ori rdf:type gwsw:Putorientatie ;
       gwsw:hasAspect
   [ 
       rdf:type gwsw:Punt ;
       gwsw:hasValue ?Punt ;
   ] .
  optional { # waarden met inwinning-meta (hou var-naam uniek: 3x asp?, 2x dat?) (zie Default_Punt.rq) (20261013)
    
    optional {
      { SELECT ?ori (COUNT(*) AS ?count)
        WHERE {
          ?ori gwsw:hasConnection [ rdf:type gwsw:Maaiveldorientatie ; gwsw:hasAspect ?aspX ; ] . # optionele selectie binnen de subquery (20261013)
          ?aspX rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue ?mvdX .
          ?aspX gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datX ; ] ; ] .
        } GROUP BY ?ori
      }
    }
    { 
      SELECT ?ori ?Maaiveldhoogte ?datumInwinningMaaiveld ?wijzeInwinningMaaiveld ?count
      WHERE {
        FILTER (BOUND(?count) && ?count = 1)
        ?ori gwsw:hasConnection [ rdf:type gwsw:Maaiveldorientatie ; gwsw:hasAspect ?asp1 ; ] . # optionele selectie binnen de subquery (20261013)
        ?asp1 rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue ?Maaiveldhoogte .
        ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datumInwinningMaaiveld ; ] ; ] .
        optional { # wijze van inwinning?
          ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningMaaiveld ; ] ; ] .
        }
      }
    }
    UNION { # waarden zonder inwinning-meta (hou var-naam uniek: 3x asp?) (20261013)
      SELECT ?ori ?Maaiveldhoogte ?datumInwinningMaaiveld ?wijzeInwinningMaaiveld ?count
      WHERE {
        FILTER (BOUND(?count) && ?count > 1)
        ?ori gwsw:hasConnection [ rdf:type gwsw:Maaiveldorientatie ; gwsw:hasAspect ?asp1 ; ] . # optionele selectie binnen de subquery (20261013)
        ?asp1 rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue ?Maaiveldhoogte .
        ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datumInwinningMaaiveld ; ] ; ] .
        optional { # wijze van inwinning?
          ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningMaaiveld ; ] ; ] .
        }
      }
      ORDER BY DESC(?datumInwinningMaaiveld) # sorteer aflopend
      LIMIT 1
    }
    UNION { # waarden zonder inwinning-meta (hou var-naam uniek: 3x asp?) (20261013)
      FILTER (!BOUND(?count))
      ?ori gwsw:hasConnection [ rdf:type gwsw:Maaiveldorientatie ; gwsw:hasAspect ?asp1 ; ] .
      #FILTER NOT EXISTS {?asp1 rdf:type gwsw:Maaiveldhoogte; gwsw:hasAspect [ rdf:type gwsw:Inwinning ; ] .} # de boel is al verwerkt in de subquery
      ?asp1 gwsw:hasValue  ?Maaiveldhoogte . 
    }
  }
    # vervalt (20261013)
    #optional {?ori gwsw:hasConnection
    # [
    #    rdf:type gwsw:Maaiveldorientatie ;
    #    gwsw:hasAspect ?maaiveld ;
    # ] . 
    # ?maaiveld  rdf:type gwsw:Maaiveldhoogte ;
    #            gwsw:hasValue ?Maaiveldhoogte .
    # optional {?maaiveld gwsw:hasAspect
    # [
    #    rdf:type gwsw:Inwinning ;
    #    gwsw:hasAspect [
    #    rdf:type gwsw:DatumInwinning ;
    #    gwsw:hasValue ?datumInwinningMaaiveld ;
    #    ] ;
    # ] . }
    # optional {?maaiveld gwsw:hasAspect
    # [
    #    rdf:type gwsw:Inwinning ;
    #    gwsw:hasAspect [
    #    rdf:type gwsw:WijzeVanInwinning ;
    #    gwsw:hasReference ?wijzeInwinningMaaiveld ;
    #    ] ;
    # ] . }
    #}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Begindatum ;
       gwsw:hasValue ?Begindatum ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Einddatum ;
       gwsw:hasValue ?Einddatum ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:MateriaalPut ;
       gwsw:hasReference ?MateriaalPut ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:VormPut ;
       gwsw:hasReference ?VormPut ;
   ] .}

   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:DiameterPut ;
   # Werkt niet altijd goed? Opgelost via COALESCE (20230710)
   #      gwsw:hasValue ?BreedtePut ; # Diameter als breedte vermelden
       gwsw:hasValue ?dia ;  
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:BreedtePut ;
       gwsw:hasValue ?br ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:LengtePut ;
       gwsw:hasValue ?LengtePut ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:HoogtePut ;
       gwsw:hasValue ?HoogtePut ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Wanddikte ;
       gwsw:hasValue ?Wanddikte ;
   ] .}
   optional {?put gwsw:hasPart 
   [
       rdf:type gwsw:Fundering ;
       sesame:directType ?Fundering ;
   ] .}
  optional { # Bepaal de meest recente datum (20260416)
    SELECT ?put (MAX(?dat) as ?DatumInspectie)
    WHERE
    {
        ?put gwsw:isInputOf [
          rdf:type gwsw:Inspecteren ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?put
  }
  optional { # Bepaal de meest recente datum (20260416)
    SELECT ?put (MAX(?dat) as ?DatumReiniging)
    WHERE
    {
        ?put gwsw:isInputOf [
          rdf:type gwsw:Reinigen ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?put
  }
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:AantalWoningen ;
       gwsw:hasValue ?AantalWoningen ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieBedrijven ;
       gwsw:hasValue ?Aantal_ieBedrijven ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieRecreatie ;
       gwsw:hasValue ?Aantal_ieRecreatie ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:AfvoerendOppervlak ;
       gwsw:hasValue ?AfvoerendOppervlak ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:BergendOppervlak ;
       gwsw:hasValue ?BergendOppervlak ;
   ] .}
   BIND (COALESCE (?br, ?dia) as ?BreedtePut) # de eerst geldende doet mee (20230710)   
   BIND (strafter(str(?put), "#") AS ?uri)
}
