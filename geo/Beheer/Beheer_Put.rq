# Beheer_Put.rq (20170930)

# 20261016/mv: Voor 3D weergave: contouren put erbij (?Buitengrens)
#              Buitengrens alleen voor 3D nabewerking (export CityGML), niet in GML/XSD
# 20261013/mv: Selecteer op datum inwinning maaiveld, alleen meest recente waarde gebruiken
# 20260416/mv: Alleen meest recente datum Inspecteren en Reinigen (voorkom dubbele geo-objecten)

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

#PREFIX gwsw: <http://data.gwsw.nl/1.7/totaal/>
PREFIX gwsw: <{{&version}}>

SELECT ?Stelsel ?stelseltype ?naam ?uri ?type ?Punt ?Buitengrens ?Begindatum ?Einddatum ?Maaiveldhoogte ?datumInwinningMaaiveld ?wijzeInwinningMaaiveld ?MateriaalPut ?VormPut ?BreedtePut ?LengtePut ?HoogtePut ?Wanddikte ?Fundering ?DatumReiniging ?DatumInspectie ?AantalWoningen ?Aantal_ieBedrijven ?Aantal_ieRecreatie ?AfvoerendOppervlak ?BergendOppervlak

WHERE
{ 
  ?put rdf:type gwsw:Rioolput .

  # Via thema Aansluiting (20190403)
  #UNION
  #{ ?put rdf:type gwsw:Kolk . }

  ?put sesame:directType ?type .

  FILTER (!(isBlank(?put)))
  FILTER (!(isBlank(?type)))

  # Nog niet actief gemaakt, kloppen de datasets voldoende?
  #FILTER NOT EXISTS { ?type rdfs:subClassOf gwsw:ExtraObjecttype } # Alleen functionele types (20261011)

  ?put rdfs:label ?naam .

  optional
  {   
    ?put gwsw:isPartOf 
    [ rdf:type gwsw:Stelsel ;
      rdfs:label ?Stelsel ;
      sesame:directType ?stelseltype ;
    ] .
  }
  ?put gwsw:hasAspect ?ori .
  ?ori rdf:type gwsw:Putorientatie ;
      gwsw:hasAspect [ rdf:type gwsw:Punt ; gwsw:hasValue ?Punt ; ] .
  optional {?ori gwsw:hasAspect [ rdf:type gwsw:Buitengrens ; gwsw:hasValue ?Buitengrens ; ] .} # Toegevoegd (niet in XSD, alleen voor 3D bewerking) (20261016)

  optional { # Meest recente maaiveldhoogte (20261016)

    ?ori gwsw:hasConnection ?oriMvd .
    ?oriMvd rdf:type gwsw:Maaiveldorientatie .

    # Gebruik UNION met bepaling maximum DatumInwinnnig, deze werkt (eindelijk) (20261014)
  
    { # Inwinning erbij?
      { 
        SELECT ?oriMvd (MAX(?datInw1) as ?datumInwinningMaaiveld)  # Zoek de meest recente waarde (hou var-naam uniek: 2x aspInw?, 2x datInw?, 1x maxDat?)
          WHERE {
            ?oriMvd gwsw:hasAspect ?aspInw1 .
            ?aspInw1 rdf:type gwsw:Maaiveldhoogte ;
                     gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datInw1 ; ] ; ] .
          } GROUP BY ?oriMvd
      }
      # Lees de gegevens bij maxDat? (hou var-naam uniek: 2x asp?)
      ?oriMvd gwsw:hasAspect ?asp1 .
      ?asp1 rdf:type gwsw:Maaiveldhoogte ; 
            gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?datumInwinningMaaiveld ; ] ; ] ;
            gwsw:hasValue ?Maaiveldhoogte .
      optional {
        ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningMaaiveld ; ] ; ] ;
      }
    }
    UNION { # waarden zonder inwinning-meta (hou var-naam uniek: 3x asp?) (20261013)
      ?oriMvd gwsw:hasAspect ?asp1 .
      # de boel is al verwerkt in de subquery?
      FILTER NOT EXISTS {?asp1 rdf:type gwsw:Maaiveldhoogte; gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; ] ; ] .}
      ?asp1 gwsw:hasValue  ?Maaiveldhoogte . 

      optional { # geen datum maar wel wijze van inwinning?
        ?asp1 gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:WijzeVanInwinning ; gwsw:hasReference ?wijzeInwinningMaaiveld ; ] ; ] ;
      }
    }
  }
    # vervalt (20261013)
    #optional {?ori gwsw:hasConnection
    # [
    #    rdf:type gwsw:Maaiveldorientatie ;
    #    gwsw:hasAspect ?maaiveld ;
    # ] . 
    # ?maaiveld  rdf:type gwsw:Maaiveldhoogte ;
    #            gwsw:hasValue ?Maaiveldhoogte .
    # optional {?maaiveld gwsw:hasAspect
    # [
    #    rdf:type gwsw:Inwinning ;
    #    gwsw:hasAspect [
    #    rdf:type gwsw:DatumInwinning ;
    #    gwsw:hasValue ?datumInwinningMaaiveld ;
    #    ] ;
    # ] . }
    # optional {?maaiveld gwsw:hasAspect
    # [
    #    rdf:type gwsw:Inwinning ;
    #    gwsw:hasAspect [
    #    rdf:type gwsw:WijzeVanInwinning ;
    #    gwsw:hasReference ?wijzeInwinningMaaiveld ;
    #    ] ;
    # ] . }
    #}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Begindatum ;
       gwsw:hasValue ?Begindatum ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Einddatum ;
       gwsw:hasValue ?Einddatum ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:MateriaalPut ;
       gwsw:hasReference ?MateriaalPut ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:VormPut ;
       gwsw:hasReference ?VormPut ;
   ] .}

   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:DiameterPut ;
       gwsw:hasValue ?dia ;  
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:BreedtePut ;
       gwsw:hasValue ?br ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:LengtePut ;
       gwsw:hasValue ?LengtePut ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:HoogtePut ;
       gwsw:hasValue ?HoogtePut ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Wanddikte ;
       gwsw:hasValue ?Wanddikte ;
   ] .}
   optional {?put gwsw:hasPart 
   [
       rdf:type gwsw:Fundering ;
       sesame:directType ?Fundering ;
   ] .}
  optional { # Bepaal de meest recente datum (20260416)
    SELECT ?put (MAX(?dat) as ?DatumInspectie)
    WHERE
    {
        ?put gwsw:isInputOf [
          rdf:type gwsw:Inspecteren ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?put
  }
  optional { # Bepaal de meest recente datum (20260416)
    SELECT ?put (MAX(?dat) as ?DatumReiniging)
    WHERE
    {
        ?put gwsw:isInputOf [
          rdf:type gwsw:Reinigen ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?put
  }
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:AantalWoningen ;
       gwsw:hasValue ?AantalWoningen ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieBedrijven ;
       gwsw:hasValue ?Aantal_ieBedrijven ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieRecreatie ;
       gwsw:hasValue ?Aantal_ieRecreatie ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:AfvoerendOppervlak ;
       gwsw:hasValue ?AfvoerendOppervlak ;
   ] .}
   optional {?put gwsw:hasAspect 
   [
       rdf:type gwsw:BergendOppervlak ;
       gwsw:hasValue ?BergendOppervlak ;
   ] .}
   BIND (COALESCE (?br, ?dia) as ?BreedtePut) # de eerst geldende doet mee (20230710)   
   BIND (strafter(str(?put), "#") AS ?uri)
}
