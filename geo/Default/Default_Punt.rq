# Alle punt-objecten (alleen de compositieobjecten) (20250915)
# 20261015/mv: Ook zelfstandige compartimenten meenemen (LET OP: dataset-fout!! Water bij de wijn)
# 20261014/mv: Selecteer op datum inwinning, alleen meest recente waarde gebruiken (query-snelheid gelijk aan 20250916)
# 20261012/mv: Werkt niet goed, het datatype van mvdhgt niet wijzigen: Datum inwinning toegevoegd aan maaiveldhoogte
# 20261013/mv: Filter op alleen functionele types
# 20260416/mv: Alleen meest recente datum Inspecteren en Reinigen (voorkom dubbele geo-objecten)

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

#PREFIX gwsw: <http://data.gwsw.nl/1.7/totaal/>
PREFIX gwsw: <{{&version}}>

SELECT ?Stelsel ?stelseltype ?naam ?uri ?type ?Punt ?Begindatum ?Einddatum ?Maaiveldhoogte ?MateriaalPut ?VormPut ?BreedtePut ?LengtePut ?HoogtePut ?BreedteBouwwerk ?LengteBouwwerk ?BreedteCompartiment ?LengteCompartiment ?Wanddikte ?Fundering ?DatumReiniging ?DatumInspectie ?AantalWoningen ?Aantal_ieBedrijven ?Aantal_ieRecreatie ?AfvoerendOppervlak ?BergendOppervlak ?LateraalDebietDWA ?LateraalDebietHWA ?LateraalAfvoerendOppervlak ?aantalPompen ?aantalDrempels

WHERE
{ 
  {
    ?obj gwsw:hasAspect ?ori .
    #?ori rdf:type gwsw:TopologischElement . 
    ?ori sesame:directType ?oriType .
    FILTER (?oriType IN (gwsw:Bouwwerkorientatie, gwsw:Putorientatie, gwsw:Hulpstukorientatie)) # Alleen de compositieobjecten. [sync] met Default_Punt_deel (20250915)
  }
  UNION # ook de zelfstandige topologische elementen
  {
    ?obj rdf:type gwsw:Afvoerpunt .
    BIND (?obj as ?ori)
  }
  UNION # ook de zelfstandige topologische elementen
  {
    ?obj rdf:type gwsw:Aansluitpunt . # Supertype van Uitlaatpunt en zo (20230426) (hier stond het foute gwsw:Aanvoerpunt)
    BIND (?obj as ?ori)
  }
  UNION # ook de zelfstandige compartimenten (LET OP: dataset-fout, maar komt vaak voor: water bij de wijn) (20261015)
  {
    ?obj rdf:type gwsw:Compartiment .
    FILTER NOT EXISTS {?obj gwsw:isPartOf [rdf:type gwsw:Put ;] . } # komt al mee in Default_Punt_deel
    FILTER NOT EXISTS {?obj gwsw:isPartOf [rdf:type gwsw:Bouwwerk ;] . } # komt al mee in Default_Punt_deel
    ?obj gwsw:hasAspect ?ori .
    ?ori rdf:type gwsw:Compartimentorientatie .
  }
  FILTER (!(isBlank(?obj)))
  ?obj sesame:directType ?type .
  FILTER (!(isBlank(?type)))
  FILTER NOT EXISTS { ?type rdfs:subClassOf gwsw:ExtraObjecttype } # Alleen functionele types (20261011)

  ?ori gwsw:hasAspect
  [ 
    rdf:type gwsw:Punt ;
    gwsw:hasValue ?Punt ;
  ] .
  optional { ?obj rdfs:label ?naam . } # niet meer verplicht (alleen geometrie moet kloppen) (20220518)   
 
  optional
   {
      ?obj gwsw:isPartOf 
      [ rdf:type gwsw:Stelsel ;
        rdfs:label ?Stelsel ;
        sesame:directType ?stelseltype ;
     ] .
   }
  optional { # Meest recente maaiveldhoogte

    ?ori gwsw:hasConnection ?oriMvd .
    ?oriMvd rdf:type gwsw:Maaiveldorientatie .

    # Gebruik UNION met bepaling maximum DatumInwinnnig, deze werkt (eindelijk) (20261014)
  
    { # Inwinning erbij?
      { 
        SELECT ?oriMvd (MAX(?maxDat1) as ?maxDat1) # Zoek de meest recente waarde (hou var-naam uniek: 2x maxAsp?, 3x maxDat?) (20261015)
          WHERE {
            ?oriMvd gwsw:hasAspect ?maxAsp1 .
            ?maxAsp1 rdf:type gwsw:Maaiveldhoogte ;
                     gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?maxDat1 ; ] ; ] .
          } GROUP BY ?oriMvd
      }
      # Lees de gegevens bij maxDat? (hou var-naam uniek: 2x asp?)
      ?oriMvd gwsw:hasAspect ?asp1 .
      ?asp1 rdf:type gwsw:Maaiveldhoogte ; 
            gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; gwsw:hasValue ?maxDat1 ; ] ; ] ;
            gwsw:hasValue ?Maaiveldhoogte .
    }
    UNION { # waarden zonder inwinning-meta (hou var-naam uniek: 3x asp?) (20261013)
      ?oriMvd gwsw:hasAspect ?asp1 .
      # de boel is al verwerkt in de subquery?
      FILTER NOT EXISTS {?asp1 rdf:type gwsw:Maaiveldhoogte; gwsw:hasAspect [ rdf:type gwsw:Inwinning ; gwsw:hasAspect [ rdf:type gwsw:DatumInwinning ; ] ; ] .}
      ?asp1 gwsw:hasValue  ?Maaiveldhoogte . 
    }
   }
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:Begindatum ;
       gwsw:hasValue ?Begindatum ;
   ] .}
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:Einddatum ;
       gwsw:hasValue ?Einddatum ;
   ] .}
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:MateriaalPut ;
       gwsw:hasReference ?MateriaalPut ;
   ] . }
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:VormPut ;
       gwsw:hasReference ?VormPut ;
   ] . }
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:DiameterPut ;
   # Werkt niet altijd goed? Opgelost via COALESCE (20230710)
   #      gwsw:hasValue ?BreedtePut ; # Diameter als breedte vermelden
       gwsw:hasValue ?dia ;  
   ] .}
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:BreedtePut ;
       gwsw:hasValue ?br ;
   ] .}
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:LengtePut ;
       gwsw:hasValue ?LengtePut ;
   ] .}
      optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:HoogtePut ;
       gwsw:hasValue ?HoogtePut ;
   ] .}
    optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:BreedteBouwwerk ;
       gwsw:hasValue ?BreedteBouwwerk ;
   ] .}
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:LengteBouwwerk ;
       gwsw:hasValue ?LengteBouwwerk ;
   ] .}
   optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:Wanddikte ;
       gwsw:hasValue ?Wanddikte ;
   ] .}
   optional {?obj gwsw:hasPart 
   [
       rdf:type gwsw:Fundering ;
       sesame:directType ?Fundering ;
   ] .}
  optional { # Bepaal de meest recente datum. Niet groeperen, veldformaat blijft xsd:date  (20260416)
    SELECT ?obj (MAX(?dat) as ?DatumInspectie)
    WHERE
    {
        ?obj gwsw:isInputOf [
          rdf:type gwsw:Inspecteren ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?obj
  }
  optional { # Bepaal de meest recente datum. Niet groeperen, veldformaat blijft xsd:date  (20260416)
    SELECT ?obj (MAX(?dat) as ?DatumReiniging)
    WHERE
    {
        ?obj gwsw:isInputOf [
          rdf:type gwsw:Reinigen ;
          gwsw:hasAspect
          [
            rdf:type gwsw:DatumMaatregel ;
            gwsw:hasValue ?dat ;
          ] ; 
        ] .
    }
    GROUP BY ?obj
  }
  optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:AantalWoningen ;
       gwsw:hasValue ?AantalWoningen ;
   ] .}
  optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieBedrijven ;
       gwsw:hasValue ?Aantal_ieBedrijven ;
   ] .}
  optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:Aantal_ieRecreatie ;
       gwsw:hasValue ?Aantal_ieRecreatie ;
   ] .}
  optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:AfvoerendOppervlak ;
       gwsw:hasValue ?AfvoerendOppervlak ;
   ] .}
  optional {?obj gwsw:hasAspect 
   [
       rdf:type gwsw:BergendOppervlak ;
       gwsw:hasValue ?BergendOppervlak ;
   ] .}
  optional {?obj gwsw:hasAspect 
  [
      rdf:type gwsw:LateraalDebietDWA ;
      gwsw:hasValue ?LateraalDebietDWA ;
  ] .}
  optional {?obj gwsw:hasAspect 
  [
      rdf:type gwsw:LateraalDebietHWA ;
      gwsw:hasValue ?LateraalDebietHWA ;
  ] .}
  optional {?obj gwsw:hasAspect 
  [
      rdf:type gwsw:LateraalAfvoerendOppervlak ;
      gwsw:hasValue ?LateraalAfvoerendOppervlak ;
  ] .}
  optional {
    SELECT ?obj (count(*) as ?aantalDrempels) # tel het aantal triples
    WHERE
    {
      ?obj ?hasPart ?drp .
      ?drp rdf:type gwsw:Overstortdrempel .
    } GROUP BY ?obj
  }
  optional {
    SELECT ?obj (count(*) as ?aantalPompen) # tel het aantal triples
    WHERE
    {
      ?obj ?hasPart ?pmp .
      ?pmp rdf:type gwsw:Pomp .
    } GROUP BY ?obj
  }
  BIND (COALESCE (?br, ?dia) as ?BreedtePut) # de eerst geldende doet mee (20230710)
  BIND (?obj AS ?uri) # De complete IRI in de uitvoer (20230416)
}
