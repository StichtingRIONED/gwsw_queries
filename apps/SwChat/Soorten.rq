# SWchat: Soorten Fysieke objecten in NL-vorm (zie ook Lijsten) (20251013)
# Distinct toegevoegd, anders dubbeling als SuperClass een multiparent heeft (bij Lijsten, 20150914)
# Alleen klasse + superklasse, dat is voldoende om de soortenboom te herleiden

# Sorteermarkers .01. enzo, zie readme.md 

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

PREFIX gwsw: <http://data.gwsw.nl/1.6/totaal/>
#PREFIX gwsw: <{{&version}}>

SELECT DISTINCT ?rec #?json

FROM <http://www.ontotext.com/explicit> # GrpahDB: gebruik alleen expliciete (not-inferred) binnen default Graph

where
{
  BIND (str(iri(gwsw:)) AS ?aft) # De datamodel-prefix

  ?cls rdf:type owl:Class .
  
  FILTER (?cls != gwsw:VerzamelingSoorten) # Heeft geen toegevoegde waarde en veroorzaakt ruis (20251229) [sync] met annotaties.rq
  FILTER NOT EXISTS {?cls rdfs:subClassOf gwsw:VerzamelingSoorten .} # Heeft geen toegevoegde waarde en veroorzaakt ruis (20251229) [sync] met soorten.rq

  FILTER (CONTAINS(str(?cls), ?aft))
  ?cls rdfs:label ?lab .
  FILTER (lang(?lab) = "nl") # de nl-versie is er altijd (20251101)
  
  ?cls rdfs:subClassOf ?sup .
  ?sup rdf:type owl:Class .
  FILTER (CONTAINS(str(?sup), ?aft))
  ?sup rdfs:label ?labS .
  FILTER (lang(?labS) = "nl") # de nl-versie is er altijd (20251101)
  
  #UNION {
  #  FILTER NOT EXISTS {?cls rdfs:subClassOf ?sup .}
  #  BIND ("Topconcept" AS ?labS)
  #}

  #BIND (IF (CONTAINS(str(?lab), " "), CONCAT("{{", ?lab, "}}"), ?lab) AS ?labCls)
  BIND (CONCAT("{{", ?lab, "}}") AS ?labCls)

  #BIND (IF (CONTAINS(str(?labS), " "), CONCAT("{{", ?labS, "}}"), ?labS) AS ?labSup)
  BIND (CONCAT("{{", ?labS, "}}") AS ?labSup)

  # met sorteer-volgnummer (20251219) "  1  " enz
  # subtype wordt soort, normale-mensen-taal
  BIND (concat("Een ", ?labCls, " is een soortnaam.\nEen ", ?labCls, " .01.is een soort ", ?labSup, "." ) as ?rec) 
  
  #BIND (concat("Type \"", ?lab, "\" is een subtype van \"", ?labS, "\"." ) as ?rec)
  #BIND (concat("Type ", ?labCls, " is een subtype van ", ?labSup, "." ) as ?rec)
  #BIND (concat("{\"id\": \"", ?labS, "\", \"type\": \"klasse\", \"subklasse\": \"" , ?lab, "\"}" ) as ?json)
}
